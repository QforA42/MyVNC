<Window x:Class="MyVNC.App.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyVNC.App.Controls"
        xmlns:local="clr-namespace:MyVNC.App"
        xmlns:loc="clr-namespace:MyVNC.App.Services"
        Title="MyVNC" Height="720" Width="1180" MinWidth="480" MinHeight="360"
        Background="Black"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- One tab header: name + close button. The active tab gets a lighter fill, an accent
             top/side border, and bold full-brightness text so it's unmistakable at a glance;
             inactive tabs sit flush and muted. -->
        <DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type local:SessionTab}">
            <Border x:Name="Bd" CornerRadius="8,8,0,0" Margin="4,6,0,0" Padding="12,7"
                    BorderThickness="1,1,1,0" BorderBrush="Transparent"
                    MouseLeftButtonDown="TabHeader_MouseLeftButtonDown" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Txt" Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Style="{StaticResource IconButton}"
                            Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Padding="0" Margin="8,0,0,0"
                            Tag="{Binding}" Click="CloseTab_Click" ToolTip="{loc:Loc Session.Close}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One tab's content: its framebuffer plus its own connecting/error status overlay.
             All tabs are stacked in the same cell; only the selected one is visible. -->
        <DataTemplate x:Key="TabContentTemplate" DataType="{x:Type local:SessionTab}">
            <Grid Visibility="Collapsed" x:Name="Root">
                <ContentControl Content="{Binding Framebuffer}" Focusable="False"/>
                <Border Background="#DD0F1115" Panel.ZIndex="20" x:Name="Status">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0"
                                Tag="{Binding}" Click="StatusCloseButton_Click" x:Name="StatusClose"
                                Content="{loc:Loc Session.Close}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Root" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStatusVisible}" Value="False">
                    <Setter TargetName="Status" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCloseVisible}" Value="False">
                    <Setter TargetName="StatusClose" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" MouseMove="RootGrid_MouseMove">

        <controls:TerminalCanvasBackground IsHitTestVisible="False"/>

        <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabContentTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Tab bar: shown once a second session joins this window. Windowed: pinned in place
             (tabs need to stay reachable). Fullscreen: behaves exactly like the single-session
             toolbar below — hidden until Right Ctrl + the pointer is at the very top edge — so
             it doesn't permanently cover the remote desktop's own top bar/panel. -->
        <Border x:Name="TabBar" VerticalAlignment="Top" Panel.ZIndex="10" Visibility="Collapsed"
                Background="{StaticResource BgBaseBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TabBarTransform" Y="0"/>
            </Border.RenderTransform>
            <Grid Margin="8,0,8,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left" Margin="0,0,300,0">
                    <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabHeaderTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Ctrl+Alt+Del" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,5" Margin="0,0,6,0"
                            Click="CtrlAltDel_Click"/>
                    <Button x:Name="TabActualSizeButton" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,5" Margin="0,0,6,0"
                            Click="ActualSize_Click"/>
                    <Button x:Name="TabFullscreenButton" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,5" Margin="0,0,6,0"
                            Click="Fullscreen_Click"/>
                    <Button x:Name="TabDisconnectButton" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,5"
                            Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Single-session toolbar: auto-hides, only shown while Right Ctrl is held and the
             pointer is at the very top edge, so it never steals clicks from the remote
             desktop's own top bar/panel. Hidden once a second tab joins (see TabBar above). -->
        <Border x:Name="ToolbarOverlay" VerticalAlignment="Top" Panel.ZIndex="10"
                Background="#EE171A21" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarTransform" Y="-48"/>
            </Border.RenderTransform>
            <Grid Margin="14,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SessionTitleText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SessionSubtitleText" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Ctrl+Alt+Del" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CtrlAltDel_Click"/>
                    <Button x:Name="ActualSizeButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ActualSize_Click"/>
                    <Button x:Name="FullscreenButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Fullscreen_Click"/>
                    <Button x:Name="DisconnectButton" Style="{StaticResource SecondaryButton}" Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
