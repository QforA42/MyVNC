<UserControl x:Class="MyVNC.App.Controls.RemoteFramebufferControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Background="Black">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <ScrollViewer x:Name="ScrollHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <Image x:Name="FramebufferImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"/>
        </ScrollViewer>
    </Grid>
</UserControl>
