<UserControl x:Class="MyVNC.App.Controls.TerminalCanvasBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090B0F" Offset="0"/>
                    <GradientStop Color="#12151D" Offset="0.55"/>
                    <GradientStop Color="#0C0E13" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="640" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.16">
            <Ellipse.Effect>
                <BlurEffect Radius="90"/>
            </Ellipse.Effect>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Rectangle Opacity="0.05">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,42,42" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="{StaticResource AccentBrush}" Thickness="1"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="42,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,42"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Opacity="0.05">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <TextBlock Text="&gt;_" FontFamily="Consolas" FontWeight="Bold" FontSize="360"
                   Foreground="{StaticResource AccentBrush}" Opacity="0.05"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-90"/>
    </Grid>
</UserControl>
