<Window x:Class="MyVNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyVNC.App"
        xmlns:loc="clr-namespace:MyVNC.App.Services"
        xmlns:controls="clr-namespace:MyVNC.App.Controls"
        mc:Ignorable="d"
        Title="MyVNC" Height="600" Width="400" MinWidth="340" MinHeight="360"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>

        <!-- Decorative terminal-themed backdrop behind the dashboard. -->
        <controls:TerminalCanvasBackground IsHitTestVisible="False"/>

        <!-- ===================== DASHBOARD ===================== -->
        <DockPanel Margin="22,20,22,20">

            <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <controls:AppLogo Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MyVNC" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc App.Connections}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AboutButton" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="30" Height="30" Style="{StaticResource IconButton}" Padding="0"
                            Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                            Click="AboutButton_Click" ToolTip="{loc:Loc About.Title}"/>
                    <Button x:Name="HelpButton" Content="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="30" Height="30" Style="{StaticResource IconButton}" Padding="0"
                            Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                            Click="HelpButton_Click" ToolTip="{loc:Loc Help.Title}"/>
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="30" Height="30" Style="{StaticResource IconButton}" Padding="0"
                            Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                            Click="SettingsButton_Click" ToolTip="{loc:Loc Settings.Title}"/>
                    <Button x:Name="NewConnectionButton" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="30" Height="30" Style="{StaticResource IconButton}" Padding="0"
                            Foreground="{StaticResource AccentBrush}"
                            Click="NewConnectionButton_Click" ToolTip="{loc:Loc Form.NewConnection}"/>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Text="{loc:Loc App.Search}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock x:Name="EmptyStateText" DockPanel.Dock="Top"
                       Text="{loc:Loc App.EmptyState}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"
                       Visibility="Collapsed" Margin="2,30,0,0"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConnectionsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="9" Margin="0,0,0,8" Padding="12,9">
                                <Grid MouseLeftButtonUp="ConnectionCard_MouseLeftButtonUp" Cursor="Hand" Tag="{Binding}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button FontFamily="Segoe MDL2 Assets" FontSize="11" Width="26" Height="26" Padding="6" Margin="0,0,2,0"
                                                Tag="{Binding}" Click="TogglePin_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Content" Value="&#xE734;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="{loc:Loc Card.Pin}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Content" Value="&#xE735;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="ToolTip" Value="{loc:Loc Card.Unpin}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource TextSecondaryBrush}" Padding="6" Width="26" Height="26"
                                                Tag="{Binding}" Click="EditConnection_Click" ToolTip="{loc:Loc Card.Edit}" Margin="0,0,2,0"/>
                                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource TextSecondaryBrush}" Padding="6" Width="26" Height="26"
                                                Tag="{Binding}" Click="DeleteConnection_Click" ToolTip="{loc:Loc Card.Delete}" Margin="0,0,2,0"/>
                                        <Button Content="SSH" FontSize="9" FontWeight="SemiBold" Padding="5,6" Height="26"
                                                Tag="{Binding}" Click="OpenSshTerminal_Click" ToolTip="{loc:Loc Card.OpenSsh}" Margin="0,0,6,0"
                                                Visibility="{Binding IsSshAvailable, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSshAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Loc Form.Connect}" Style="{StaticResource IconButton}" Padding="12,5" FontSize="12"
                                                Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                                Tag="{Binding}" Click="ConnectCardButton_Click"/>
                                        <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource AccentBrush}" Width="18" Height="26" Padding="0" Margin="0"
                                                Tag="{Binding}" Click="ConnectDropdown_Click" ToolTip="{loc:Loc Form.ChooseAddress}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ===================== NEW / EDIT CONNECTION OVERLAY ===================== -->
        <Border x:Name="FormOverlay" Background="#CC0B0D11" Panel.ZIndex="100" Visibility="Collapsed"
                MouseLeftButtonDown="FormOverlay_MouseLeftButtonDown">
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Width="300" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="FormCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="22,20,22,10">
                        <TextBlock x:Name="FormTitleText" Text="{loc:Loc Form.NewConnection}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource TextSecondaryBrush}" Width="24" Height="24" Padding="0"
                                HorizontalAlignment="Right" Click="CancelEdit_Click" ToolTip="{loc:Loc Session.Close}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,0,22,20">
                            <TextBlock Text="{loc:Loc Form.Name}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.Host}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="HostBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.Fqdn}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="FqdnBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.TailscaleIp}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TailscaleIpBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.TailscaleFqdn}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="TailscaleFqdnBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.DefaultAddress}" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="DefaultAddressComboBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.Port}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="PortBox" Style="{StaticResource ModernTextBox}" Text="5900" Margin="0,0,0,8"/>

                            <Button x:Name="TestConnectionButton" Content="{loc:Loc Form.TestConnection}" Style="{StaticResource SecondaryButton}"
                                    Click="TestConnectionButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TestConnectionResultText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

                            <Button x:Name="ForgetSshHostKeyButton" Content="{loc:Loc Form.ForgetSshHostKey}" Style="{StaticResource SecondaryButton}"
                                    Click="ForgetSshHostKeyButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                    ToolTip="{loc:Loc Form.ForgetSshHostKeyTooltip}"/>
                            <TextBlock x:Name="ForgetSshHostKeyResultText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

                            <TextBlock Text="{loc:Loc Form.Username}" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="{loc:Loc Form.Password}" Style="{StaticResource LabelText}"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ViewOnlyCheck" Content="{loc:Loc Form.ViewOnly}" Style="{StaticResource CheckBoxModern}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ActualSizeCheck" Content="{loc:Loc Form.ActualSizeDefault}" Style="{StaticResource CheckBoxModern}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ReceiveClipboardCheck" Content="{loc:Loc Form.ReceiveClipboard}" Style="{StaticResource CheckBoxModern}" Margin="0,0,0,8" IsChecked="True"/>
                            <CheckBox x:Name="SendClipboardCheck" Content="{loc:Loc Form.SendClipboard}" Style="{StaticResource CheckBoxModern}" Margin="0,0,0,14" IsChecked="True"/>

                            <CheckBox x:Name="RememberCheck" Content="{loc:Loc Form.Remember}" Style="{StaticResource CheckBoxModern}" Margin="0,0,0,18" IsChecked="True"/>

                            <Button x:Name="ConnectButton" Content="{loc:Loc Form.Connect}" Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" HorizontalAlignment="Stretch"/>

                            <TextBlock x:Name="StartErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ===================== SETTINGS OVERLAY ===================== -->
        <Border x:Name="SettingsOverlay" Background="#CC0B0D11" Panel.ZIndex="100" Visibility="Collapsed"
                MouseLeftButtonDown="SettingsOverlay_MouseLeftButtonDown">
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Width="300" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="FormCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="22,20,22,14">
                        <TextBlock Text="{loc:Loc Settings.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource TextSecondaryBrush}" Width="24" Height="24" Padding="0"
                                HorizontalAlignment="Right" Click="CloseSettings_Click" ToolTip="{loc:Loc Session.Close}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,0,22,20">
                            <TextBlock Text="{loc:Loc Settings.Language}" Style="{StaticResource LabelText}" Margin="2,0,0,4"/>
                            <ComboBox x:Name="LanguageComboBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>

                            <TextBlock Text="{loc:Loc Settings.SessionMode}" Style="{StaticResource LabelText}" Margin="2,0,0,6"/>
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SessionModeLabel" Grid.Column="0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                <ToggleButton x:Name="SessionModeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              Checked="SessionModeToggle_Changed" Unchecked="SessionModeToggle_Changed"/>
                            </Grid>

                            <TextBlock Text="{loc:Loc Settings.AutoReconnect}" Style="{StaticResource LabelText}" Margin="2,16,0,6"/>
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AutoReconnectLabel" Grid.Column="0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                <ToggleButton x:Name="AutoReconnectToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              Checked="AutoReconnectToggle_Changed" Unchecked="AutoReconnectToggle_Changed"/>
                            </Grid>

                            <TextBlock Text="{loc:Loc Settings.SshTerminal}" Style="{StaticResource LabelText}" Margin="2,16,0,4"/>
                            <ComboBox x:Name="SshTerminalComboBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"
                                      SelectionChanged="SshTerminalComboBox_SelectionChanged"/>

                            <TextBlock Text="{loc:Loc Settings.DebugLogging}" Style="{StaticResource LabelText}" Margin="2,0,0,6"/>
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DebugLoggingLabel" Grid.Column="0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                <ToggleButton x:Name="DebugLoggingToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              Checked="DebugLoggingToggle_Changed" Unchecked="DebugLoggingToggle_Changed"/>
                            </Grid>
                            <Button x:Name="OpenLogButton" Content="{loc:Loc Settings.OpenLog}" Style="{StaticResource SecondaryButton}"
                                    Click="OpenLogButton_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ===================== HELP OVERLAY ===================== -->
        <Border x:Name="HelpOverlay" Background="#CC0B0D11" Panel.ZIndex="100" Visibility="Collapsed"
                MouseLeftButtonDown="HelpOverlay_MouseLeftButtonDown">
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Width="320" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="FormCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="22,20,22,10">
                        <TextBlock Text="{loc:Loc Help.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource TextSecondaryBrush}" Width="24" Height="24" Padding="0"
                                HorizontalAlignment="Right" Click="CloseHelp_Click" ToolTip="{loc:Loc Session.Close}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,0,22,20">

                            <TextBlock Text="{loc:Loc Help.PasteHeader}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Help.PasteBody}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="{loc:Loc Help.HowItWorksHeader}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Help.HowItWorksBody}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="{loc:Loc Help.WayvncHeader}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Help.WayvncKeyboardBody}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Help.WayvncAddressBody}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Help.WayvncAuthBody}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="{loc:Loc Help.WayvncExampleLabel}" FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="address=0.0.0.0&#x0a;port=5900&#x0a;enable_auth=true&#x0a;enable_pam=true&#x0a;certificate_file=~/.config/wayvnc/certificate.pem&#x0a;private_key_file=~/.config/wayvnc/private_key.pem"/>
                            </Border>

                            <TextBlock Text="{loc:Loc Help.LimitationsHeader}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Help.LimitationsBody}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="AboutOverlay" Background="#CC0B0D11" Panel.ZIndex="100" Visibility="Collapsed"
                MouseLeftButtonDown="AboutOverlay_MouseLeftButtonDown">
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="FormCard_MouseLeftButtonDown">
                <StackPanel Margin="24,22,24,22">
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppLogo Margin="0,0,10,0"/>
                            <TextBlock Text="MyVNC" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource TextSecondaryBrush}" Width="24" Height="24" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseAbout_Click" ToolTip="{loc:Loc Session.Close}"/>
                    </Grid>

                    <TextBlock x:Name="AboutVersionText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc About.Description}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://github.com/QforA42/MyVNC" RequestNavigate="AboutLink_RequestNavigate">
                            github.com/QforA42/MyVNC
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
