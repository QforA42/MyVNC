<Application x:Class="MyVNC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyVNC.App">
    <!-- Resources are merged in code, by ThemeManager (see Services/ThemeManager.cs): which of
         Colors.Dark/Light.xaml applies depends on the Windows app mode, and the whole palette is
         swapped out again live whenever the user changes that mode or the accent color. A static
         merge here would pin one palette in place before any of that is known. -->
</Application>
