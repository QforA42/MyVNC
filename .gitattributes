# Text is stored and checked out with LF (repo-blueprint); Windows-only formats keep CRLF.
* text=auto eol=lf
*.{cmd,bat,ps1,iss} text eol=crlf
*.sh text eol=lf

# Binary files: never touch line endings or diff as text.
*.{png,jpg,jpeg,gif,webp,ico,pdf,zip,exe,dll,pdb} binary
# Session metrics are append-only: lines from different branches are kept, never in conflict.
project/metrics/sessions.jsonl merge=union
