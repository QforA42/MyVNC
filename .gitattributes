# Normalize line endings: text files are stored with LF in the repository and checked out with
# CRLF (this is a Windows-only project), regardless of each contributor's core.autocrlf setting.
* text=auto eol=crlf

# Shell scripts must keep LF to run on Linux/macOS/WSL.
*.sh text eol=lf

# Binary files — never touch line endings or diff as text.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
