{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const root=require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(); import(require('node:url').pathToFileURL(require('node:path').join(root,'.agents/hooks/session-start.mjs')).href)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const root=require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(); import(require('node:url').pathToFileURL(require('node:path').join(root,'.agents/hooks/pre-tool.mjs')).href)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const root=require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(); import(require('node:url').pathToFileURL(require('node:path').join(root,'.agents/hooks/post-edit.mjs')).href)\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const root=require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(); import(require('node:url').pathToFileURL(require('node:path').join(root,'.agents/hooks/stop.mjs')).href)\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const root=require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(); import(require('node:url').pathToFileURL(require('node:path').join(root,'.agents/hooks/session-end.mjs')).href)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
