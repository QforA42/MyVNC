root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.cs]
# Analyzer severities live here so `dotnet build` enforces them (EnforceCodeStyleInBuild).
dotnet_analyzer_diagnostic.category-Style.severity = warning
# unnecessary using, unused and unread private members, file-scoped namespaces
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
# ConfigureAwait is not needed in ASP.NET Core
dotnet_diagnostic.CA2007.severity = none
