<Project>

  <!-- Root VERSION is the single canonical version source for every project in the solution
       (see the "Versioning" section in CONTRIBUTING.md). AssemblyVersion/FileVersion/InformationalVersion are
       all derived from MSBuild's Version property, so nothing else needs editing when it bumps. -->
  <PropertyGroup>
    <VersionFilePath>$(MSBuildThisFileDirectory)VERSION</VersionFilePath>
    <Version Condition="Exists('$(VersionFilePath)')">$([System.IO.File]::ReadAllText('$(VersionFilePath)').Trim())</Version>
  </PropertyGroup>

  <!-- Analyzers and code style (repo-blueprint .NET gates): the same rules in IDE, build and dotnet format.
       The gates build with -warnaserror; local Debug/Release builds only warn. -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) in build; XML docs themselves are not required. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Locked restore: packages.lock.json per project; CI restores with locked mode and osv-scanner reads them. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
