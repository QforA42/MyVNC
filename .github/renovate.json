{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Stockholm",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] },
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "groupName": "minor and patch", "matchCurrentVersion": "!/^0/" },
    { "matchManagers": ["nuget"], "groupName": "nuget minor and patch", "matchUpdateTypes": ["minor", "patch"] },
    { "matchDatasources": ["docker"], "pinDigests": true }
  ]
}
